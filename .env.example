# ── LLM ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Exchanges ─────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true          # true = paper trading

COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_SANDBOX=true         # true = paper trading

SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_PAPER=true             # true = paper trading

# ── Data sources ──────────────────────────────────────
NEWS_API_KEY=
PERPLEXITY_API_KEY=
TWITTER_BEARER_TOKEN=

# ── Notifications ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Risk controls ─────────────────────────────────────
MAX_POSITION_PCT=0.05         # 5% kapitału na trade
MAX_DAILY_DRAWDOWN_PCT=0.02   # 2% max strata dzienna
ALERT_LOSS_PCT=0.01           # alert Telegram przy >1% stracie

# ── General ───────────────────────────────────────────
TRADING_MODE=paper            # paper | live  (NIE zmieniaj bez testu 60 dni)
LOG_LEVEL=INFO
LOG_DIR=./logs
